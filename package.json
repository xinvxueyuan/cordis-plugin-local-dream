{
  "name": "@xinvxueyuan/cordis-plugin-local-dream",
  "version": "0.1.0",
  "description": "Cordis (DeepSeek Harness) plugin: drive the Android Local Dream Stable Diffusion app over its embedded HTTP backend — LAN-first, USB/adb fallback — with automatic device connection management",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "vendor",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "author": {
    "name": "xinvxueyuan",
    "email": "xinvxueyuan@yeah.net",
    "url": "https://github.com/xinvxueyuan"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "node --test test/unit.test.ts test/register.test.ts",
    "test:integration": "node test/integration.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinvxueyuan/cordis-plugin-local-dream.git"
  },
  "homepage": "https://github.com/xinvxueyuan/cordis-plugin-local-dream",
  "bugs": {
    "url": "https://github.com/xinvxueyuan/cordis-plugin-local-dream/issues"
  },
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "local-dream",
    "stable-diffusion",
    "android",
    "adb",
    "sse",
    "plugin",
    "tool"
  ],
  "license": "MIT OR Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.0"
  }
}
